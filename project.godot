; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Major Jam 7"
run/main_scene="uid://dws5etkbb3vq7"
config/features=PackedStringArray("4.4", "GL Compatibility")
boot_splash/bg_color=Color(0.34902, 0.560784, 0.313726, 1)
boot_splash/fullsize=false
boot_splash/use_filter=false
boot_splash/image="uid://i8bg8alxlurb"
config/icon="uid://bsuhy268klumw"

[autoload]

GameManager="*res://scripts/Managers/game_manager.gd"
Transition="*res://scenes/UI/transition.tscn"
MusicManager="*res://scenes/Audio/music_manager.tscn"
RuleManager="*res://scripts/Managers/rule_manager.gd"
KeyManager="*res://scripts/Managers/key_manager.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=360
window/stretch/mode="viewport"
mouse_cursor/custom_image="uid://mxxtb86xxoyg"

[file_customization]

folder_colors={
"res://assets/": "red",
"res://misc/": "green",
"res://scenes/": "purple",
"res://scenes/Fire/": "red",
"res://scenes/HoseAndWater/": "blue",
"res://scenes/Objects/": "orange",
"res://scenes/Player/": "pink",
"res://scenes/Tiles/": "purple",
"res://scenes/UI/": "green",
"res://scripts/": "blue",
"res://scripts/Fire/": "red",
"res://scripts/HoseAndWater/": "blue",
"res://scripts/Managers/": "yellow",
"res://scripts/Objects/": "orange",
"res://scripts/Player/": "pink",
"res://scripts/Tiles/": "purple",
"res://scripts/UI/": "green",
"res://sounds/": "yellow"
}

[gui]

theme/custom_font="uid://b82diaeapk85u"
theme/default_font_antialiasing=0
theme/default_font_subpixel_positioning=0

[importer_defaults]

wav={
"compress/mode": 2,
"edit/loop_begin": 0,
"edit/loop_end": -1,
"edit/loop_mode": 2,
"edit/normalize": false,
"edit/trim": false,
"force/8_bit": false,
"force/max_rate": false,
"force/max_rate_hz": 44100,
"force/mono": false
}

